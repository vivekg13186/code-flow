# code flow configuration — copy to .codeflow.env and adjust
# (scripts/install.sh / install.bat generate this file for you;
#  real environment variables always override these values)

# where your flow .py files live (subfolders become tags; _lib/ for shared code)
CODEFLOW_WORKFLOWS_DIR=./workflows

# environment JSON files (dev.json, prod.json, ...; ${VAR} refs resolve from OS env)
CODEFLOW_ENVIRONMENTS_DIR=./environments

# run records, HTML reports and schedules.json live here
CODEFLOW_HISTORY_DIR=./history

# keep at most this many runs; oldest finished are pruned automatically
CODEFLOW_HISTORY_LIMIT=500

# bind address — keep 127.0.0.1 unless you know what you're doing
# (the app has no authentication; use Tailscale/VPN for remote access)
CODEFLOW_HOST=127.0.0.1
CODEFLOW_PORT=8000

# optional: require this token on all /api/hooks/* webhook calls
# (per-flow webhook_token attributes override it)
#CODEFLOW_WEBHOOK_TOKEN=change-me

# optional: schedules.json location (default: <history>/schedules.json)
#CODEFLOW_SCHEDULES_FILE=./history/schedules.json
